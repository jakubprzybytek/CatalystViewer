{
  "name": "catalyst-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sst dev",
    "build": "sst build",
    "deploy": "sst deploy",
    "remove": "sst remove",
    "console": "sst console",
    "typecheck": "sst install && tsc --noEmit && tsc --noEmit -p packages/core && tsc --noEmit -p packages/functions && tsc --noEmit -p packages/web",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "seed": "esrun scripts/seed-int/seed-int.ts",
    "quote": "esrun packages/core/src/bonds/catalyst/catalyst.ts quote",
    "classify-issuer": "esrun --send-code-mode=temporaryFile --node-env-file-if-exists=.env.local packages/core/src/ai/issuers/cli.ts classify",
    "analyze-issuer": "esrun --send-code-mode=temporaryFile --node-env-file-if-exists=.env.local packages/core/src/ai/issuers/cli.ts analyze",
    "import-filing": "esrun --send-code-mode=temporaryFile scripts/import-filing/import-filing.ts",
    "check-filings": "esrun --send-code-mode=temporaryFile scripts/check-filings/check-filings.ts",
    "reparse-filings": "esrun --send-code-mode=temporaryFile scripts/reparse-filings/reparse-filings.ts",
    "item-totals": "esrun --send-code-mode=temporaryFile scripts/item-totals/item-totals.ts",
    "resolve-issuers": "esrun --send-code-mode=temporaryFile scripts/resolve-issuers/resolve-issuers.ts",
    "sort-filings": "esrun --send-code-mode=temporaryFile scripts/sort-filings/sort-filings.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxlint": "1.90.0",
    "sst": "4.17.2",
    "typescript": "7.0.2",
    "vitest": "^4.1.12",
    "write-excel-file": "4.1.1"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "esrun": "3.2.30"
  },
  "overrides": {
    "react": "^19",
    "react-dom": "^19",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esrun": {
      "esbuild": "^0.25.0"
    },
    "worker-f": "0.1.20"
  }
}
